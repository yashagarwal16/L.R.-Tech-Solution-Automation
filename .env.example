# Safe template for local development and Render.
# Never commit real credentials. Copy to .env.local and replace every value.

MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/lrtech

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=notifications@example.com
SMTP_APP_PASSWORD=replace_with_gmail_app_password
OWNER_NOTIFICATION_EMAIL=owner@example.com
MANAGER_NOTIFICATION_EMAIL=manager@example.com
ADDITIONAL_NOTIFICATION_EMAILS=

# Optional future Twilio WhatsApp configuration. Sending is not active yet.
TWILIO_ACCOUNT_SID=replace_with_twilio_account_sid
TWILIO_AUTH_TOKEN=replace_with_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+replace_with_destination_number

AUTH_SESSION_SECRET=replace_with_a_long_random_session_secret
AUTH_OWNER_EMAIL=owner@example.com
AUTH_OWNER_PASSWORD=replace_with_unique_password
AUTH_MANAGER_EMAIL=manager@example.com
AUTH_MANAGER_PASSWORD=replace_with_unique_password
AUTH_EMPLOYEE_EMAIL=employee@example.com
AUTH_EMPLOYEE_PASSWORD=replace_with_unique_password
AUTH_FINANCE_EMAIL=finance@example.com
AUTH_FINANCE_PASSWORD=replace_with_unique_password
AUTH_HR_EMAIL=hr@example.com
AUTH_HR_PASSWORD=replace_with_unique_password
AUTH_CLIENT_EMAIL=client@example.com
AUTH_CLIENT_PASSWORD=replace_with_unique_password

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=contact@example.com
NEXT_PUBLIC_CONTACT_PHONE=replace_with_phone_number
